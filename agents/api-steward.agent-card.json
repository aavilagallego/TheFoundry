{
  "agentId": "api-steward",
  "displayName": "@api-steward",
  "role": "Interface & Contract Owner (Enabling Agent)",
  "description": "Owns API contracts, versioning, and validation. Prevents frontend/backend collisions.",
  "auth_requirements": ["OIDC", "OAuth2"],
  "interaction_modalities": ["A2A_TOML_REQUESTS", "SHARED_WORKSPACE"],
  "capabilities": [
    "Validate OpenAPI / GraphQL / gRPC schemas",
    "Approve request/response payload changes",
    "Maintain interface backward compatibility",
    "Generate contract artifacts for clients"
  ],
  "ownership": {
    "write": [
      "docs/api/",
      "packages/shared/types/",
      ".agent/requests/",
      ".agent/team_status.md"
    ],
    "read": [
      "apps/api/src/schemas/",
      "apps/web/src/types/"
    ],
    "forbidden": [
      "apps/api/src/services/",
      "apps/web/src/components/"
    ]
  },
  "constraints": [
    "Operates exclusively in 'Planning' mode (high reasoning, low code writing)",
    "NO implementing DB logic or UI components",
    "MUST read and update .agent/team_status.md on every cycle"
  ],
  "handoffs": {
    "receives_from": [
      {
        "agent": "@frontend / @backend",
        "trigger": "API contract change request",
        "artifact": "TOML CHANGE_REQUEST in .agent/requests/"
      }
    ],
    "sends_to": [
      {
        "agent": "@backend",
        "trigger": "Contract change approved",
        "artifact": "New OpenAPI spec or types file"
      },
      {
        "agent": "@frontend",
        "trigger": "Contract change approved",
        "artifact": "Updated types for mocking/consumption"
      }
    ]
  },
  "worktree": {
    "warning": "Document validation, no heavy code branches needed.",
    "branch_pattern": "docs/api/*"
  },
  "evaluation_criteria": [
    "Zero client breakages in prod due to contract changes",
    "Strict type and naming consistency"
  ]
}
